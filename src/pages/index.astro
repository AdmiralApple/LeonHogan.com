---
import Base from '../layouts/Base.astro';
import GameCard from '../components/GameCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import { getGames, getPosts } from '../lib/games';
import { getReviews, rated, played as getPlayed } from '../lib/reviews';
import { formatDate } from '../site';

const games = await getGames();
const featured = games.filter((g) => g.data.featured).slice(0, 3);
const allReviews = await getReviews();
const played = getPlayed(allReviews);
const recent = rated(allReviews).slice(0, 6);
const nowPlaying = allReviews.filter((r) => r.status === 'Playing');
const posts = (await getPosts()).slice(0, 3);
const completed = allReviews.filter((r) => r.status === 'Completed').length;
---

<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Welcome to <span class="hl">LeonHogan.com</span>.</h1>
        <div class="btn-row">
          <a class="btn primary" href="/games/">See my games</a>
          <a class="btn" href="/reviews/">Read my reviews</a>
        </div>
      </div>
      <dl class="stats">
        <div><dt>Games made</dt><dd>{games.length}</dd></div>
        <div><dt>Games played</dt><dd>{played.length}</dd></div>
        <div><dt>Completed</dt><dd>{completed}</dd></div>
        {
          nowPlaying.length > 0 && (
            <div class="now">
              <dt>Now playing</dt>
              <dd>{nowPlaying.map((r) => r.title).join(', ')}</dd>
            </div>
          )
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Featured games</h2>
        <a class="more-link" href="/games/">All {games.length} projects</a>
      </div>
      <div class="grid">{featured.map((g) => <GameCard game={g} />)}</div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head">
        <h2>Recently played</h2>
        <a class="more-link" href="/reviews/">Full game log</a>
      </div>
      <div class="grid">{recent.map((r) => <ReviewCard review={r} />)}</div>
    </div>
  </section>

  {
    posts.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <h2>From the blog</h2>
            <a class="more-link" href="/blog/">All posts</a>
          </div>
          <ul class="posts">
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`}>
                  <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                  <span class="t">{p.data.title}</span>
                  <span class="d">{p.data.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>

<style>
  .hero {
    padding-block: clamp(48px, 9vw, 110px) clamp(32px, 6vw, 64px);
    border-bottom: 1px solid var(--line);
    background:
      radial-gradient(700px 320px at 92% 10%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(500px 260px at 0% 100%, color-mix(in srgb, var(--teal) 12%, transparent), transparent 70%);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: clamp(28px, 5vw, 64px);
    align-items: end;
  }
  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-bottom: 1.8rem;
    overflow-wrap: anywhere;
  }
  .hl {
    color: var(--accent);
  }
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .stats > div {
    padding: 18px 16px;
    border-right: 1px solid var(--line);
  }
  .stats > div:nth-child(3) {
    border-right: 0;
  }
  .stats dt {
    font: 600 0.68rem/1.2 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    margin-bottom: 0.4rem;
  }
  .stats dd {
    margin: 0;
    font: 800 2.2rem/1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .stats .now {
    grid-column: 1 / -1;
    border-right: 0;
    border-top: 1px solid var(--line);
    background: var(--bg-sunken);
  }
  .stats .now dd {
    font-size: 1.05rem;
    line-height: 1.35;
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0;
  }
  .stats .now dt::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.45em;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 25%, transparent);
  }
  .band {
    background: color-mix(in srgb, var(--bg-sunken) 55%, transparent); /* the hold shows through */
    border-block: 1px solid var(--line);
  }
  .posts {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .posts a {
    display: grid;
    grid-template-columns: 9rem 1fr;
    column-gap: 1.5rem;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .posts time {
    grid-row: span 2;
    font: 600 0.8rem/1.9 var(--font-mono);
    color: var(--ink-faint);
  }
  .posts .t {
    font: 700 1.2rem/1.3 var(--font-display);
  }
  .posts a:hover .t {
    color: var(--accent);
  }
  .posts .d {
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .posts a {
      grid-template-columns: 1fr;
    }
    .posts time {
      grid-row: auto;
    }
  }
</style>
