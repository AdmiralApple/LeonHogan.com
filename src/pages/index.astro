---
import Base from '../layouts/Base.astro';
import { getGames, getPosts } from '../lib/games';
import { getReviews, rated, played as getPlayed } from '../lib/reviews';
import { formatDate, scoreBand } from '../site';

const games = await getGames();
const featured = games.filter((g) => g.data.featured).slice(0, 3);
const allReviews = await getReviews();
const played = getPlayed(allReviews);
const recent = rated(allReviews).slice(0, 6);
const nowPlaying = allReviews.filter((r) => r.status === 'Playing');
const posts = (await getPosts()).slice(0, 3);
const completed = allReviews.filter((r) => r.status === 'Completed').length;
// a steady colour from a game's id, for a thumbnail when it has no cover
const hueOf = (s: string) => [...s].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) % 360, 0);
---

<Base>
  <!-- Signposts: the home page is a descent through the dwarf hold behind it. Each part of the site is a small plate
       at its own depth, left and right by turns, with open hold between one and the next; the footer rests on the
       magma at the bottom. -->
  <div class="descent">
    <section class="plate hero">
      <h1>Welcome to <span class="hl">LeonHogan.com</span>.</h1>
      <div class="btn-row">
        <a class="btn primary" href="/games/">See my games</a>
        <a class="btn" href="/reviews/">Read my reviews</a>
      </div>
      <dl class="stats">
        <div><dt>Games made</dt><dd>{games.length}</dd></div>
        <div><dt>Games played</dt><dd>{played.length}</dd></div>
        <div><dt>Completed</dt><dd>{completed}</dd></div>
      </dl>
      {
        nowPlaying.length > 0 && (
          <p class="now">
            <b>Now playing</b> {nowPlaying.map((r) => r.title).join(', ')}
          </p>
        )
      }
    </section>

    <section class="plate">
      <div class="plate-head">
        <h2>Featured games</h2>
        <a class="more-link" href="/games/">All {games.length} projects</a>
      </div>
      <ul class="rows">
        {
          featured.map((g) => (
            <li>
              <a href={`/games/${g.id}/`}>
                {g.data.cover ? (
                  <img src={g.data.cover} alt="" loading="lazy" decoding="async" />
                ) : (
                  <span class="thumb" style={`--h:${hueOf(g.id)}`} aria-hidden="true" />
                )}
                <span>
                  <span class="t">{g.data.title}</span>
                  <span class="s">{g.data.tagline}</span>
                </span>
                <span class="year">{g.data.year}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="plate">
      <div class="plate-head">
        <h2>Recently played</h2>
        <a class="more-link" href="/reviews/">Full game log</a>
      </div>
      <ul class="rows">
        {
          recent.map((r) => (
            <li>
              <a href={`/reviews/#${r.id}`}>
                {r.cover ? (
                  <img src={r.cover} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                ) : (
                  <span class="thumb" style={`--h:${hueOf(r.id)}`} aria-hidden="true" />
                )}
                <span>
                  <span class="t">{r.title}</span>
                  <span class="s">
                    {r.status}
                    {r.date && ` · ${formatDate(r.date)}`}
                  </span>
                </span>
                {r.rating !== null && (
                  <span class={`score ${scoreBand(r.rating)}`} aria-label={`${r.rating} out of 10`}>
                    {r.rating}
                  </span>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      posts.length > 0 && (
        <section class="plate">
          <div class="plate-head">
            <h2>From the blog</h2>
            <a class="more-link" href="/blog/">All posts</a>
          </div>
          <ul class="rows posts">
            {posts.map((p) => (
              <li>
                <a href={`/blog/${p.id}/`}>
                  <span>
                    <time datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
                    <span class="t">{p.data.title}</span>
                    <span class="s">{p.data.description}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

<style>
  .descent {
    display: flex;
    flex-direction: column;
    padding-inline: clamp(16px, 5vw, 80px);
  }
  /* a plate: the only part of the page that covers the hold */
  .plate {
    width: min(500px, 100%);
    margin-top: 62vh;
    padding: 22px 24px;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(8px) saturate(1.1);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .plate:nth-child(even) {
    align-self: flex-end;
  }
  .plate.hero {
    margin-top: 14vh;
    width: min(600px, 100%);
  }
  h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin-bottom: 1.1rem;
    overflow-wrap: anywhere;
  }
  .hl {
    color: var(--accent);
  }
  .btn-row {
    margin-bottom: 1.4rem;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .stats dt {
    font: 600 0.66rem/1.2 var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-faint);
    margin-bottom: 0.35rem;
  }
  .stats dd {
    margin: 0;
    font: 800 2rem/1 var(--font-display);
    letter-spacing: -0.03em;
  }
  .now {
    margin: 1rem 0 0;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .now b {
    color: var(--ink);
  }
  .now::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.5em;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--teal) 25%, transparent);
  }
  .plate-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .plate-head h2 {
    font-size: 1.45rem;
    margin: 0;
  }
  /* compact rows: a thumbnail, a title and a line under it, and a year or a score */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .rows a {
    display: grid;
    grid-template-columns: 72px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .rows li:first-child a {
    border-top: 0;
  }
  .rows img,
  .thumb {
    width: 72px;
    height: 40px;
    border-radius: 6px;
    object-fit: cover;
    background: var(--bg-sunken);
  }
  .thumb {
    display: block;
    background: linear-gradient(135deg, hsl(var(--h) 70% 55%), hsl(calc(var(--h) + 60) 65% 40%));
  }
  .t {
    display: block;
    font-weight: 600;
    line-height: 1.25;
  }
  .rows a:hover .t {
    color: var(--accent);
  }
  .s {
    display: block;
    margin-top: 2px;
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--ink-faint);
  }
  .year {
    font: 600 0.75rem/1 var(--font-mono);
    color: var(--ink-faint);
  }
  .score {
    display: grid;
    place-items: center;
    min-width: 2em;
    height: 2em;
    border-radius: 7px;
    font: 800 0.88rem/1 var(--font-mono);
    color: #120e0a;
  }
  .score.great {
    background: var(--great);
  }
  .score.good {
    background: var(--good);
  }
  .score.meh {
    background: var(--meh);
  }
  .score.bad {
    background: var(--bad);
  }
  .posts a {
    grid-template-columns: 1fr;
  }
  .posts time {
    display: block;
    font: 600 0.72rem/1.6 var(--font-mono);
    color: var(--ink-faint);
  }
  @media (max-width: 700px) {
    .plate,
    .plate.hero {
      width: 100%;
      margin-top: 40vh;
    }
    .plate.hero {
      margin-top: 8vh;
    }
  }
</style>
