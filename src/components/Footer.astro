---
import { SITE, SOCIALS, NAV } from '../site';
const year = new Date().getFullYear();
---

<!-- The footer rests on the magma at the very bottom of the dwarf hold: a stretch of open depths above it, then one
     slim frosted line of links, so nothing hides the bottom of the world. -->
<footer class="site-footer">
  <div class="floor">
    <span class="sig">© {year} {SITE.name}</span>
    <ul>
      {NAV.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      <li><a href="/rss.xml">RSS</a></li>
      {SOCIALS.map((s) => <li><a href={s.href} rel="me noopener" target="_blank">{s.label} ↗</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 62vh;
    padding: 0 16px 24px;
    display: flex;
    justify-content: center;
  }
  .floor {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 6px 18px;
    max-width: 100%;
    padding: 10px 20px;
    border-radius: 22px;
    background: color-mix(in srgb, var(--bg) 72%, transparent);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    font-size: 0.86rem;
  }
  .sig {
    font: 700 0.86rem/1.4 var(--font-display);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    text-decoration: none;
    color: var(--ink-soft);
  }
  a:hover {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .site-footer {
      margin-top: 40vh;
    }
  }
</style>
